{
  "name": "entrelinhas",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --bundles deb",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib -j 2",
    "test:desktop": "python3 scripts/test-desktop.py",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tiptap/extension-highlight": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-task-item": "3.35.0",
    "@tiptap/extension-task-list": "3.35.0",
    "@tiptap/extension-text-align": "3.35.0",
    "@tiptap/extension-text-style": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "dompurify": "3.4.18",
    "lucide-react": "1.77.0",
    "marked": "18.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
