{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entrelinhas",
  "version": "1.1.2",
  "identifier": "io.github.bitdevy.entrelinhas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Entrelinhas",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Um espaço tranquilo para escrever",
    "longDescription": "Editor de texto com escrita imersiva, Markdown e projetos locais.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "resources/entrelinhas.desktop",
        "conflicts": ["entre-linhas"],
        "replaces": ["entre-linhas"],
        "depends": [
          "xdg-desktop-portal",
          "xdg-desktop-portal-gnome | xdg-desktop-portal-gtk",
          "zenity"
        ]
      }
    }
  }
}
