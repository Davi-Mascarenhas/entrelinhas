{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English",
          "Japanese",
          "SimpChinese",
          "German",
          "Portuguese",
          "SpanishInternational",
          "Spanish",
          "TradChinese"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/branding/header.bmp",
        "sidebarImage": "windows/branding/sidebar.bmp",
        "uninstallerHeaderImage": "windows/branding/header.bmp",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      }
    },
    "publisher": "Davi Mascarenhas",
    "copyright": "Copyright © 2026 Davi Mascarenhas",
    "createUpdaterArtifacts": true
  }
}
