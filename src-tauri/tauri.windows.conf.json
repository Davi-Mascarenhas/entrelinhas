{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/branding/header.bmp",
        "sidebarImage": "windows/branding/sidebar.bmp",
        "uninstallerHeaderImage": "windows/branding/header.bmp",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      }
    },
    "publisher": "Bit-Devy",
    "copyright": "Copyright © 2026 Bit-Devy",
    "createUpdaterArtifacts": true
  }
}
